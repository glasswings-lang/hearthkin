__pycache__
/build/
/dist/
.venv

# Time for Family game, cloned here at build time to bundle into the release
# (it lives in its own repo, github.com/glasswings-lang/time-for-family).
/.bundle_game/

# Build-time output. Hearthkin.ico IS committed (source asset), but
# the licenses/ directory is regenerated by scripts/bundle_licenses.py
# from the installed Python packages on the build machine, so its
# contents shouldn't live in source control.
licenses/

# Claude Code session log — local handoff notes between sessions.
# Mirrors the .claudecontext pattern used in simpleclaw-rs.
# Never commit; it's session-specific and may contain in-progress notes.
.claudecontext

# Claude Code worktrees / per-session helper scripts. The main repo's
# .claude/worktrees/ holds in-progress agent worktrees; per-session
# scratch (audit scripts, planning notes) lives in .claude/ subdirs of
# those worktrees. None of it belongs in the public repo.
.claude/

# Local-only working notes — machine-specific paths / personal test
# checklists. Same class as .claudecontext: never committed to the public
# repo, they just live on the operator's machine.
# Private working documents. One directory rule rather than a list of
# filenames -- a .gitignore is public, and naming each private file
# advertises exactly what exists and what it is about.
docs/private/

# Editor / OS scratch
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Personal scratchpad for git commit messages (git commit -F msg.txt); never
# tracked. Widened to msg*.txt so a second message drafted for a second commit
# can't be picked up by `git add` and committed as a file.
msg*.txt

# Test-suite sandboxes. run_all.py creates a fresh subdirectory per run
# under here and removes it afterwards (--keep leaves it for inspection).
# Never written into directly — see tests/run_all.py.
/tests/.state/
