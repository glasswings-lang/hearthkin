#!/bin/sh
# Refuse a commit whose MESSAGE carries a private string.
#
# Commit messages are not files, so `git ls-files` cannot see them and the
# pre-commit file scan misses them entirely. Message text is what made the
# old development history unpublishable, so it gets its own gate.
#
# Live via core.hooksPath (see githooks/pre-commit for the one-line setup).
repo="$(git rev-parse --show-toplevel)" || exit 1

python "$repo/tests/test_no_private_strings.py" --check-message "$1"
if [ $? -ne 0 ]; then
    echo ""
    echo "=============================================================="
    echo "COMMIT BLOCKED - the message did not pass the private-string"
    echo "guard. Nothing has been committed. Reword and try again."
    echo "=============================================================="
    exit 1
fi
exit 0
